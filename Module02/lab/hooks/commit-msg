#!/usr/bin/env bash
# Hook commit-msg: rechaza mensajes que no sigan Conventional Commits.
# commit-msg hook: rejects messages that do not follow Conventional Commits.
#
# Activacion / Activation (los hooks de .git/hooks no se versionan, por eso se usa una carpeta propia
# / hooks in .git/hooks are not versioned, so a folder of our own is used):
#   git config core.hooksPath Module02/lab/hooks
#
# Idioma de los mensajes / Message language:  LAB_LANG=en git commit ...   (por defecto / default: es)
#
# Recuerda / Remember: se puede saltar con `git commit --no-verify`, asi que esto es una ayuda
# local y NO reemplaza la verificacion en CI. / it can be skipped with `--no-verify`, so this is
# a local aid and does NOT replace the CI check.

patron='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'
primera_linea="$(head -n 1 "$1")"

# Los commits que genera Git por su cuenta no siguen el formato: se dejan pasar.
# Commits generated by Git itself do not follow the format: they are let through.
case "$primera_linea" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! [[ "$primera_linea" =~ $patron ]]; then
  if [ "${LAB_LANG:-es}" = "en" ]; then
    cat >&2 <<EOF
Commit message rejected:
  $primera_linea

Expected format:  type(optional scope)!: description in imperative mood
Valid types:      feat fix docs style refactor perf test build ci chore revert
Examples:         fix(grades): correct integer division in final_grade
                  feat(api)!: remove the v1 endpoint
EOF
  else
    cat >&2 <<EOF
Mensaje de commit rechazado:
  $primera_linea

Formato esperado:  tipo(alcance opcional)!: descripcion en imperativo
Tipos validos:     feat fix docs style refactor perf test build ci chore revert
Ejemplos:          fix(notas): corregir division entera en nota_final
                   feat(api)!: eliminar el endpoint v1
EOF
  fi
  exit 1
fi
